generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  MARKETER
}

/// Lifecycle of a SaleVali customer, from unqualified prospect to churn.
/// Mirrors the real funnel on salevali.de: contact -> demo/consultation ->
/// 30 day free trial -> paying subscription -> cancellation (30 day notice).
enum LifecycleStage {
  PROSPECT_100
  CONTACTED_200
  DEMO_SCHEDULED_300
  DEMO_COMPLETED_400
  TRIAL_ACTIVE_500
  TRIAL_EXPIRED_600
  CUSTOMER_ACTIVE_700
  CANCELLATION_NOTICE_800
  CHURNED_900
  LOST_950
  DISQUALIFIED_990
}

/// How the customer reached SaleVali.
enum CustomerSource {
  WEBSITE_TRIAL
  DEMO_REQUEST
  AFFILIATE
  CONSULTANT
  REFERRAL
  MARKETPLACE
  OUTBOUND
  ADS
  EVENT
  OTHER
}

/// SaleVali billing model. Invoice-only users pay a fixed monthly fee,
/// API-connected users are billed per transaction in tiers.
enum PricingModel {
  UNDECIDED
  INVOICE_ONLY_FIXED
  API_TRANSACTION_TIERED
}

/// State of the SEPA direct debit mandate used for billing.
enum SepaMandateStatus {
  NONE
  REQUESTED
  ACTIVE
  FAILED
}

/// Sales channels and shipping providers a customer can connect to SaleVali.
enum IntegrationChannel {
  AMAZON
  EBAY
  KAUFLAND
  OTTO
  ETSY
  SHOPIFY
  SHOPWARE
  WOOCOMMERCE
  PRESTASHOP
  DHL
  DPD
  GLS
  UPS
  HERMES
  CUSTOM_API
  OTHER
}

enum IntegrationStatus {
  INTERESTED
  IN_PROGRESS
  CONNECTED
  BLOCKED
}

/// UI language the customer works in — SaleVali ships DE / EN / TR.
enum CustomerLocale {
  DE
  EN
  TR
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum InteractionType {
  EMAIL
  CALL
  WHATSAPP
  MEETING
  DEMO
  ONBOARDING
  NOTE
}

/// A member of the marketing team. Users are the operators of this CRM,
/// not the records it tracks — customers are tracked, marketers do the tracking.
model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  name                String
  role                UserRole          @default(MARKETER)
  passwordHash        String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdCustomers    Customer[]        @relation("CustomerCreatedBy")
  createdContacts     Contact[]         @relation("ContactCreatedBy")
  createdCampaigns    Campaign[]        @relation("CampaignCreatedBy")
  createdInteractions Interaction[]     @relation("InteractionCreatedBy")
  createdTasks        Task[]            @relation("TaskCreatedBy")
  stageChanges        StageChange[]     @relation("StageChangeCreatedBy")
  invitationsCreated  InvitationToken[] @relation("InvitationCreatedBy")
  assignedCustomers   Customer[]        @relation("CustomerAssignedTo")
  assignedTasks       Task[]            @relation("TaskAssignedTo")
}

model InvitationToken {
  id          String    @id @default(cuid())
  email       String
  role        UserRole
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String
  createdBy   User      @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([email, expiresAt])
}

/// The central record of this CRM: a company that uses — or should use —
/// the SaleVali multichannel ERP. Online merchants, not marketing staff.
model Customer {
  id           String            @id @default(cuid())
  companyName  String
  legalName    String?
  website      String?
  country      String            @default("DE") @db.VarChar(2)
  city         String?
  vatId        String?
  locale       CustomerLocale    @default(DE)
  industry     String?
  stage        LifecycleStage    @default(PROSPECT_100)
  source       CustomerSource    @default(OTHER)
  pricingModel PricingModel      @default(UNDECIDED)

  /// Monthly order/transaction volume — drives the tiered API pricing and
  /// tells us how valuable the account is.
  monthlyTransactions Int?
  /// Expected or actual monthly recurring revenue for SaleVali.
  mrr                 Decimal?  @db.Decimal(12, 2)
  currency            String    @default("EUR") @db.VarChar(3)

  trialStartedAt      DateTime?
  trialEndsAt         DateTime?
  convertedAt         DateTime?
  cancellationNoticeAt DateTime?
  churnedAt           DateTime?
  closedAt            DateTime?

  sepaMandateStatus SepaMandateStatus @default(NONE)

  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedToId String?
  assignedTo   User?     @relation("CustomerAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User      @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  contacts     Contact[]
  integrations CustomerIntegration[]
  interactions Interaction[]
  tasks        Task[]
  stageHistory StageChange[]

  @@index([stage])
  @@index([assignedToId])
  @@index([campaignId])
  @@index([createdById])
  @@index([trialEndsAt])
}

/// A person at a customer company — the human the marketing team talks to.
model Contact {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String?   @unique
  phone       String?
  title       String?
  isPrimary   Boolean   @default(false)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User      @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId])
}

/// Which sales channels / shipping providers the customer runs. Both a
/// segmentation signal and the concrete value SaleVali delivers to them.
model CustomerIntegration {
  id         String             @id @default(cuid())
  customerId String
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    IntegrationChannel
  status     IntegrationStatus  @default(INTERESTED)
  notes      String?            @db.Text
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([customerId, channel])
  @@index([channel, status])
}

/// Acquisition channel a customer came in through (affiliate push, ad set,
/// consultant partnership, webinar). Not the main entity — attribution only.
model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?        @db.Text
  status      CampaignStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?       @db.Decimal(12, 2)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String
  createdBy   User           @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  customers   Customer[]
}

/// Every touch the marketing team logs against a customer.
model Interaction {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        InteractionType
  subject     String?
  body        String?         @db.Text
  happenedAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  createdById String
  createdBy   User            @relation("InteractionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId, happenedAt])
}

/// Follow-up work owned by a marketer for a specific customer.
model Task {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title        String
  description  String?   @db.Text
  dueDate      DateTime?
  done         Boolean   @default(false)
  doneAt       DateTime?
  assignedToId String?
  assignedTo   User?     @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String
  createdBy    User      @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId, dueDate])
  @@index([assignedToId, done])
}

/// Audit trail of lifecycle transitions, so funnel conversion and time-in-stage
/// can be measured instead of guessed.
model StageChange {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromStage   LifecycleStage?
  toStage     LifecycleStage
  note        String?         @db.Text
  changedAt   DateTime        @default(now())
  createdById String
  createdBy   User            @relation("StageChangeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId, changedAt])
  @@index([toStage, changedAt])
}
